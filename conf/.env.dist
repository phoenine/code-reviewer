# Server port
SERVER_PORT=5001

# Timezone
TZ=Asia/Shanghai

# LLM provider: deepseek, openai, zhipuai, qwen, ollama, anthropic
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini

# ZhipuAI
ZHIPUAI_API_KEY=
ZHIPUAI_API_MODEL=GLM-4-Flash

# Qwen
QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_MODEL=qwen-coder-plus

# Ollama (Docker: use host.docker.internal instead of 127.0.0.1)
OLLAMA_API_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_MODEL=deepseek-r1:latest

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=
ANTHROPIC_API_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096

# Supported file extensions for review
SUPPORTED_EXTENSIONS=.java,.py,.ts,.tsx,.js,.html,.scss,.sql,.yaml,.yml,.sh,.go,.json
# Max tokens per review (exceeding parts are truncated)
REVIEW_MAX_TOKENS=10000
# HTTP request timeout (seconds)
HTTP_TIMEOUT_SECONDS=10
# Review style: professional | sarcastic | gentle | humorous
REVIEW_STYLE=professional

# ==============================================
# Notification channel configuration
# ==============================================
# Security notes:
# - DingTalk supports HMAC-SHA256 signing (set DINGTALK_SECRET_ENABLED=1)
# - WeCom and Feishu do not support signing, only webhook URL required
# ==============================================

# DingTalk
DINGTALK_ENABLED=0
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET_ENABLED=0   # Enable HMAC signing (DingTalk only)
DINGTALK_SECRET=

# WeCom (WeChat Work)
WECOM_ENABLED=0
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# Feishu (Lark)
FEISHU_ENABLED=0
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# Custom webhook
# Receives POST with data={ai_codereview_data: {}, webhook_data: {}}
# Useful for Feishu app notifications or custom integrations
EXTRA_WEBHOOK_ENABLED=0
EXTRA_WEBHOOK_URL=http://feishu-relay:8090/notify

# Logging
LOG_FILE=log/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3
LOG_LEVEL=DEBUG

# GitLab
#GITLAB_URL=https://gitlab.example.com  # Uncomment for GitLab < v15 that doesn't send URL in webhook
#GITLAB_ACCESS_TOKEN=glpat-...  # GitLab API token (required)
#GITLAB_WEBHOOK_SECRET=...      # Optional: verify X-Gitlab-Token header

# GitHub (if using GitHub as code hosting platform)
#GITHUB_ACCESS_TOKEN=github_pat_...  # GitHub API token (required)
#GITHUB_WEBHOOK_SECRET=...           # Optional: verify X-Hub-Signature-256 header

# Push review: set to 0 to disable review on push events
PUSH_REVIEW_ENABLED=1
# Review only when merging to protected branches
# (ensure protected branches are configured in your repo)
MERGE_REVIEW_ONLY_PROTECTED_BRANCHES_ENABLED=0

# Dashboard credentials
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=your-dashboard-password

# Webhook async worker (fixed thread pool + bounded queue)
WORKER_MAX_WORKERS=4
WORKER_MAX_QUEUE_SIZE=64
