# Relay service bind
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=INFO

# Optional: protect relay endpoint with shared token header X-Relay-Token
RELAY_TOKEN=

# Feishu app credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_OPEN_BASE_URL=https://open.feishu.cn

# Mapping files (relative to relay/feishu-notify-relay/)
GIT_USER_TO_NAME_FILE=config/git_user_to_name.json
FEISHU_OPEN_IDS_FILE=config/feishu_open_ids.json
